   ],
   "parameters": {
    "jsCode": "\nconst clip = (s, n) => String(s ?? '').replace(/[\\u0000-\\u001f\\u007f​-‏‪-‮⁠-⁩﻿]/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, n);\n\nconst b = $input.first().json.body || {};\nif (b.type === 'status') return [{ json: { kind: 'status', account: clip(b.account, 100), state: clip(b.state, 10), error: clip(b.error, 200) } }];\nif (b.type !== 'mail') return [];\nconst from_addr = clip(b.from_addr, 200).toLowerCase();\nconst from_name = clip(b.from_name, 120);\n// our own Notify Me emails must not come back as chat messages\nif (from_addr === __JS:EMAIL_FROM_ADDR__ && from_name.toLowerCase() === __JS:EMAIL_FROM_NAME__.toLowerCase()) return [];\nconst subject = clip(b.subject, 300);\nconst text = String(b.text || '').slice(0, 8000);\nconst to = Array.isArray(b.to) ? b.to.map(x => clip(x, 200).toLowerCase()) : [];\nconst account = clip(b.account, 100);\nconst alias = to.find(x => (__JS:MAIL_ALIASES__).includes(x));\nconst label = alias || account;\n\n// fast OTP: a code word + a code close to it. No AI, so it reaches WhatsApp in seconds.\nconst head = subject + '\\n' + text.slice(0, 2500);\nlet otp = '';\nconst g = head.match(/\\bG-(\\d{6})\\b/);\nif (g) otp = g[1];\nif (!otp) {\n  const KW = /(\\b(?:otp|one[- ]?time|verification|verify|passcode|security code|login code|sign[- ]?in code|access code|auth(?:entication)? code|confirmation code|2fa|two[- ]factor|pin)\\b|رمز|كود|التحقق|تحقق|لمرة واحدة)/ig;\n  const kws = [...head.matchAll(KW)].map(m => m.index);\n  if (kws.length) {\n    const CAND = /(?<![\\w\\/.#@$£€,-])(\\d{3}[ -]\\d{3}|\\d{4,8}|(?=[A-Z0-9]*\\d)(?=[A-Z0-9]*[A-Z])[A-Z0-9]{6,8})(?![\\w\\/@%,-]|\\.\\d)/g;\n    let best = null;\n    for (const m of head.matchAll(CAND)) {\n      const v = m[1];\n      if (/^(19|20)\\d\\d$/.test(v)) continue;            // a year, not a code\n      const d = Math.min(...kws.map(k => Math.abs(m.index - k)));\n      if (d > 300) continue;\n      if (!best || d < best.d) best = { v, d };\n    }\n    if (best) otp = best.v.replace(/[ -]/g, '');\n  }\n}\nreturn [{ json: {\n  kind: 'mail', account, label, uid: Number(b.uid) || null,\n  message_id: clip(b.message_id, 300), mail_date: clip(b.date, 100),\n  from_name, from_addr, to: to.join(', '), subject, text,\n  attachments: (Array.isArray(b.attachments) ? b.attachments : []).map(x => clip(x, 80)).join(', ').slice(0, 300),\n  list_unsubscribe: !!b.list_unsubscribe, otp } }];\n"
   }
