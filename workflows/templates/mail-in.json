   "parameters": {
    "jsCode": "\nconst clip = (s, n) => String(s ?? '').replace(/[\\u0000-\\u001f\\u007f​-‏‪-‮⁠-⁩﻿]/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, n);\n\nconst p = $('Prepare').first().json;\nlet r = null;\ntry { r = JSON.parse($json.choices[0].message.content); } catch (e) { r = null; }\nif (!r || !['otp', 'important', 'normal', 'promo'].includes(r.category)) {\n  // model failed: a personal-looking email still reaches the owner now, bulk mail waits for the digest\n  r = { category: p.list_unsubscribe ? 'normal' : 'important', otp_code: '', summary: __TJS:mail_unsummarized__.replace('{subject}', p.subject) };\n}\nlet code = clip(r.otp_code, 20).replace(/\\s/g, '');\nif (r.category === 'otp' && !/^[A-Za-z0-9-]{3,12}$/.test(code)) { r.category = 'important'; code = ''; }\nreturn [{ json: { category: r.category, code, summary: clip(r.summary, 400).replace(/https?:\\/\\/\\S+/g, '').trim() } }];\n"
   }
