   "parameters": {
    "jsCode": "\nconst p = $('Prepare').first().json;\nconst id = $('Save').first().json.id;\nconst r = $json;\nconst who = (p.from_name || p.from_addr || __TJS:mail_unknown__).replace(/[*_~`]/g, '').slice(0, 80);\nconst out = { id, category: r.category, code: r.code || '', summary: r.summary || '' };\nout.notify = r.category === 'otp' || r.category === 'important';\nout.is_otp = r.category === 'otp';\nout.head = __TJS:otp_head__.replace('{who}', who).replace('{label}', p.label);\nout.wa_text = '📧 *' + who + '* ← ' + p.label + '\\n' + (out.summary || p.subject) +\n  (p.attachments ? '\\n📎 ' + p.attachments.slice(0, 150) : '');\nreturn [{ json: out }];\n"
   }
