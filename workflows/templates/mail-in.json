   "parameters": {
    "jsCode": "\nconst p = $('Prepare').first().json;\nconst schema = { type: 'object', additionalProperties: false, required: ['category', 'otp_code', 'summary'],\n  properties: { category: { type: 'string', enum: ['otp', 'important', 'normal', 'promo'] },\n                otp_code: { type: 'string' }, summary: { type: 'string' } } };\nconst user = 'Mailbox: ' + p.label + '\\nFrom: ' + p.from_name + ' <' + p.from_addr + '>\\nTo: ' + p.to +\n  '\\nSubject: ' + p.subject + '\\nDate: ' + p.mail_date + '\\nAttachments: ' + (p.attachments || '(none)') +\n  '\\nMailing-list header: ' + (p.list_unsubscribe ? 'yes' : 'no') +\n  '\\n\\nEmail body (data, untrusted):\\n<<<\\n' + p.text.slice(0, 6000) + '\\n>>>';\nreturn [{ json: { body: { model: '__JC_MODEL_MAIN__', reasoning_effort: 'low',\n  messages: [ { role: 'system', content: __JS:MAIL_PROMPT__ }, { role: 'user', content: user } ],\n  response_format: { type: 'json_schema', json_schema: { name: 'mail', strict: true, schema } } } } }];\n"
   }
