   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    220,
    0
   ],
   "parameters": {
    "jsCode": "\nconst b = $input.first().json.body || {};\nconst hb = b.heartbeat || null;\nconst mon = b.monitor || {};\nconst CALL = __JS:CALL_MONITORS__;\nconst clean = s => String(s || '').replace(/[\\u0000-\\u001f]/g, ' ').trim();\nconst name = clean(mon.name).slice(0, 80);\nif (!hb) return [{ json: { kind: 'info', title: '📈 Uptime Kuma', message: clean(b.msg).slice(0, 800) } }];\nconst msg = clean(hb.msg).slice(0, 300);\nconst url = clean(mon.url && mon.url !== 'https://' ? mon.url : (mon.hostname ? mon.hostname + ':' + mon.port : ''));\nif (hb.status === 0) return [{ json: { kind: CALL.includes(name) ? 'down_prod' : 'down', name, url: mon.url || '',\n  keyword: mon.keyword || '', title: __TJS:uptime_down_title__.replace('{name}', name), message: __TJS:uptime_down_msg__.replace('{name}', name) + '\\n' + msg + (url ? '\\n' + url : '') } }];\nif (hb.status === 1) return [{ json: { kind: 'up', name, title: __TJS:uptime_up_title__.replace('{name}', name), message: __TJS:uptime_up_msg__.replace('{name}', name) } }];\nreturn [];\n"
   }
  },
