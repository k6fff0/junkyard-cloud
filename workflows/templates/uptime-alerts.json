   "parameters": {
    "jsCode": "const p = $('Parse').first().json;\nconst r = $input.first().json;\nconst code = r.statusCode || 0;\nlet down = !(code >= 200 && code < 400);\nif (!down && p.keyword) down = !String(r.body || '').includes(p.keyword);\nreturn [{ json: { down, message: __TJS:uptime_still_down__.replace('{name}', p.name).replace('{code}', code || __TJS:no_reply__) } }];\n"
   }
