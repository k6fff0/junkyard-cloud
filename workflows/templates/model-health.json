   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    440,
    0
   ],
   "parameters": {
    "jsCode": "const fill = (s, o) => s.replace(/\\{(\\w+)\\}/g, (_, k) => (k in o ? String(o[k]) : ''));\nconst r = $input.first().json;\nconst code = r.statusCode || 0;\nconst ok = code === 200;\nconst body = typeof r.body === 'string' ? r.body : JSON.stringify(r.body || r.error || r);\nconst quota = /insufficient_quota|exceeded your current quota|billing/i.test(body);\nconst sd = $getWorkflowStaticData('global');\nconst before = sd.ok;            // undefined on the first run\nsd.ok = ok;\nif (before === undefined && ok) return [];\nif (before === ok) return [];\nconst A = { assistant: __JS:ASSISTANT__ };\nif (ok) return [{ json: { title: __TJS:health_back_title__, message: fill(__TJS:health_back_msg__, A), channels: '__JC_CH_IMPORTANT__' } }];\nreturn [{ json: { title: __TJS:health_down_title__,\n  message: (quota ? __TJS:health_quota__ : fill(__TJS:health_noreply__, { code })) + fill(__TJS:health_stops__, A) +\n    __TJS:health_works__ + __TJS:health_reply__ + body.slice(0, 200),\n  channels: '__JC_CH_ALL_TEXT__' } }];\n"
   }
  },
