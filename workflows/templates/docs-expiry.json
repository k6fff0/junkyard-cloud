  {
   "id": "__NEWID__",
   "name": "Due today?",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    660,
    0
   ],
   "parameters": {
    "jsCode": "const fill = (s, o) => s.replace(/\\{(\\w+)\\}/g, (_, k) => (k in o ? String(o[k]) : ''));\nconst DAYS = __JS:DAYS__;\nconst days = n => (DAYS[new Intl.PluralRules('__JC_LANG__').select(n)] || DAYS.other).replace('{n}', n);\nconst clean = s => String(s || '').replace(/[\\u0000-\\u001f\\u007f\\u200b-\\u200f\\u202a-\\u202e\\u2066-\\u2069]/g, ' ').replace(/\\s+/g, ' ').trim();\nconst types = Object.fromEntries($('Types').first().json.results.map(t => [t.id, t.name]));\nconst today = $now.setZone('__JC_TZ__').startOf('day');\nconst hits = [];\nfor (const d of $('Documents').first().json.results || []) {\n  const f = (d.custom_fields || []).find(x => x.field === __JC_EXPIRY_FIELD__);\n  if (!f || !f.value) continue;\n  const n = Math.round(DateTime.fromISO(f.value, { zone: '__JC_TZ__' }).diff(today, 'days').days);\n  if ([30, 7, 1, 0].includes(n)) hits.push({ n, line: (n === 0 ? __TJS:expiry_today__ : n === 1 ? __TJS:expiry_tomorrow__ :\n    fill(__TJS:expiry_days__, { days: days(n) })) + clean(d.title) + ' (' + (types[d.document_type] || '') + ') - ' + f.value +\n    '\\n__JC_DOCS_URL__/documents/' + d.id + '/details' });\n}\nif (!hits.length) return [];\nhits.sort((a, b) => a.n - b.n);\nreturn [{ json: { title: __TJS:expiry_title__, message: hits.map(h => h.line).join('\\n\\n'),\n  priority: hits.some(h => h.n <= 1) ? 'important' : 'normal' } }];\n"
   }
  },
