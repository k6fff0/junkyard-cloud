    }
   }
  },
  {
   "id": "__NEWID__",
   "name": "Call and connect to voice bridge",
   "type": "n8n-nodes-base.twilio",
   "typeVersion": 1,
   "position": [
    240,
    0
   ],
   "parameters": {
    "resource": "call",
    "operation": "make",
