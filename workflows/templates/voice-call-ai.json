    "message": "={{ '<Response><Connect><Stream url=\"__JC_VOICE_STREAM_URL__\"><Parameter name=\"context\" value=\"' + ($json.context || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/\"/g, '&quot;') + '\"/></Stream></Connect></Response>' }}",
    "options": {}
   },
   "credentials": {
    "twilioApi": {
     "id": "__CRED:Twilio__",
     "name": "Twilio"
    }
   }
  },
  {
   "id": "__NEWID__",
   "name": "Result",
   "type": "n8n-nodes-base.set",
   "typeVersion": 3.4,
   "position": [
    480,
    0
   ],
   "parameters": {
    "mode": "manual",
    "assignments": {
     "assignments": [
      {
       "id": "o",
       "name": "ok",
       "type": "boolean",
       "value": true
      },
      {
       "id": "s",
       "name": "call_status",
       "type": "string",
       "value": "={{ $json.status }}"
      }
     ]
    },
    "options": {}
   }
  }
 ],
