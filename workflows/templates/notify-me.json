  {
   "id": "__NEWID__",
   "name": "Normalize",
   "type": "n8n-nodes-base.set",
   "typeVersion": 3.4,
   "position": [
    220,
    0
   ],
   "parameters": {
    "mode": "manual",
    "assignments": {
     "assignments": [
      {
       "id": "t",
       "name": "title",
       "type": "string",
       "value": "={{ $json.body ? $json.body.title : $json.title }}"
      },
      {
       "id": "m",
       "name": "message",
       "type": "string",
       "value": "={{ $json.body ? $json.body.message : $json.message }}"
      },
      {
       "id": "p",
       "name": "priority",
       "type": "string",
       "value": "={{ ($json.body ? $json.body.priority : $json.priority) || 'normal' }}"
      },
      {
       "id": "c",
       "name": "channels",
       "type": "array",
       "value": "={{ (() => { const allowed = __JS:CHANNELS__; const raw = ($json.body || $json).channels; const list = (Array.isArray(raw) ? raw : String(raw || '').split(/[\\s,]+/)).map(c => String(c).trim().toLowerCase()).filter(c => allowed.includes(c)); if (list.length) return [...new Set(list)]; const p = ($json.body || $json).priority || 'normal'; const by = __JS:PRIORITY_CHANNELS__; return by[p] || by.normal; })() }}"
      }
     ]
    },
    "options": {}
   }
  },
  {
   "id": "__NEWID__",
   "name": "Telegram",
   "webhookId": "__NEWID__",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "onError": "continueRegularOutput",
   "position": [
    700,
    -200
   ],
   "parameters": {
    "resource": "message",
    "operation": "sendMessage",
    "chatId": "__JC_TG_CHAT__",
    "text": "={{ ({normal: '🔔', important: '⚠️', emergency: '🚨'})[$json.priority || 'normal'] || '🔔' }} {{ $json.title || __TJS:alert_title__ }}\n\n{{ $json.message }}",
    "additionalFields": {
     "appendAttribution": false
    }
   },
