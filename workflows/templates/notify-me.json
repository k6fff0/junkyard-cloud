    700,
    400
   ],
   "parameters": {
    "resource": "call",
    "operation": "make",
    "from": "__JC_TWILIO_FROM__",
    "to": "__JC_OWNER_PHONE__",
    "twiml": true,
    "message": "={{ '<Response><Pause length=\"1\"/>' + '<Say language=\"__JC_TTS_LANG__\" voice=\"__JC_TTS_VOICE__\">' + (($json.title || __TJS:alert_title__) + '. ' + ($json.message || '')).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</Say>' + '<Pause length=\"1\"/>' + '<Say language=\"__JC_TTS_LANG__\" voice=\"__JC_TTS_VOICE__\">' + (($json.title || __TJS:alert_title__) + '. ' + ($json.message || '')).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;') + '</Say>' + '</Response>' }}",
    "options": {}
   },
   "credentials": {
    "twilioApi": {
     "id": "__CRED:Twilio__",
     "name": "Twilio"
    }
   }
  },
  {
   "id": "__NEWID__",
   "name": "WhatsApp",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "onError": "continueRegularOutput",
   "position": [
    700,
    200
   ],
   "parameters": {
    "method": "POST",
    "url": "__JC_WAHA_URL__/api/sendText",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify({ session: '__JC_WA_SESSION__', chatId: '__JC_WA_CHAT__', text: (({normal: '🔔', important: '⚠️', emergency: '🚨'})[$json.priority || 'normal'] || '🔔') + ' *' + ($json.title || __TJS:alert_title__) + '*\\n\\n' + ($json.message || '') }) }}",
    "options": {}
   },
   "credentials": {
    "httpHeaderAuth": {
     "id": "__CRED:WAHA key__",
     "name": "WAHA key"
    }
   }
