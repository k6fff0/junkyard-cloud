   "parameters": {
    "operation": "executeQuery",
    "query": "DELETE FROM jc_web_taint WHERE ts < now() - interval '2 days';\nINSERT INTO jc_web_taint (exec_id) VALUES ($1) ON CONFLICT DO NOTHING RETURNING exec_id;",
    "options": {
     "queryReplacement": "={{ String($('Called by workflow').first().json.exec_id || 'missing') }}"
    }
   },
   "credentials": {
    "postgres": {
     "id": "__CRED:Assistant database__",
     "name": "Assistant database"
    }
   }
  },
