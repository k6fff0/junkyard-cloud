  },
  {
   "id": "__NEWID__",
   "name": "Action",
   "type": "n8n-nodes-base.switch",
   "typeVersion": 3.2,
   "position": [
    220,
    200
   ],
   "parameters": {
    "mode": "expression",
    "numberOutputs": 3,
    "output": "={{ ({save: 0, search: 1, recent: 2})[$json.action] ?? 1 }}",
    "options": {}
   }
  },
  {
   "id": "__NEWID__",
   "name": "Prepare save",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    440,
    0
   ],
   "parameters": {
    "jsCode": "\nconst t = $('Called by workflow').first().json;\nconst raw = String(t.arg1 || '').trim();\nlet o = {}; try { o = JSON.parse(t.arg2 || '{}') } catch (e) {}\nif (!raw) return [{ json: { skip: true, result: 'Nothing to save: send the link or the text.' } }];\n// saved EXACTLY as the owner gave it: only a full http(s) link becomes a link bookmark; anything else (e.g. router.example.net) is kept as-is as text\nconst m = raw.match(/^https?:\\/\\/[^\\s<>\"']+$/i);\nconst url = m ? m[0] : null;\nconst body = url ? { type: 'link', url: url } : { type: 'text', text: raw.slice(0, 20000) };\nif (o.title) body.title = String(o.title).slice(0, 300);\nif (o.note) body.note = String(o.note).slice(0, 2000);\nconst tags = String(o.tags || '').split(/[,،]/).map(s => s.trim()).filter(Boolean).slice(0, 10);\nreturn [{ json: { body, tags } }];\n"
   }
  },
  {
   "id": "__NEWID__",
   "name": "Create bookmark",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "onError": "continueRegularOutput",
   "position": [
    660,
    0
   ],
   "parameters": {
    "method": "POST",
    "url": "__JC_KARAKEEP_URL__/api/v1/bookmarks",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "options": {
     "timeout": 30000
    },
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "={{ JSON.stringify($json.body) }}"
   },
   "credentials": {
    "httpHeaderAuth": {
     "id": "__CRED:Karakeep token__",
     "name": "Karakeep token"
    }
   }
  },
  {
   "id": "__NEWID__",
   "name": "Saved",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    880,
    0
   ],
   "parameters": {
    "jsCode": "\nconst r = $input.first().json;\nconst prep = $('Prepare save').first().json;\nif (!r || !r.id) return [{ json: { result: 'Saving failed: ' + JSON.stringify(r).slice(0, 300) } }];\nconst what = r.content?.type === 'link' ? (r.content.url || '') : 'note/text';\nconst title = r.title || prep.body.title || '';\nreturn [{ json: { id: r.id, tags: prep.tags, result: (r.alreadyExists ? 'Already saved before (id ' : 'Saved (id ') + r.id + '): ' + what +\n  (title ? ' | title: ' + title : ' | no title given (Karakeep will use the page title)') +\n  (prep.body.note ? ' | note: ' + prep.body.note : '') +\n  (r.alreadyExists && prep.body.title && r.title !== prep.body.title ? ' | NOTE: it existed already, the new title was NOT applied' : '') +\n  '. Tell the owner exactly this, do not claim anything else.' } }];\n"
   }
  },
  {
   "id": "__NEWID__",
   "name": "Has tags?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2.2,
   "position": [
    1100,
    0
   ],
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "loose",
      "version": 2
     },
     "conditions": [
      {
       "id": "t",
       "leftValue": "={{ ($json.tags || []).length > 0 && !!$json.id }}",
       "rightValue": "",
       "operator": {
        "type": "boolean",
        "operation": "true",
        "singleValue": true
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   }
  },
  {
   "id": "__NEWID__",
