#!/bin/sh
# jc-isolate <name>
# Keeps the containers of one Docker network away from the home network, the server itself and other
# containers: they may reach the public internet only, plus the exceptions written in
# /etc/junkyard/isolate/<name>.conf. Used for every service that opens links or reads content from
# strangers (web reader, downloads, mail, link saver, media), so that content can never reach the
# router, the password vault or the photos.
#
# The .conf file (shell syntax):
#   BRIDGE=br-downloads          Linux bridge of the Docker network (compose: driver_opts
#                                com.docker.network.bridge.name)
#   SUBNET=172.30.14.0/24        the network itself; its containers may talk to each other
#   GATEWAY=172.30.14.1          the server's address on that network (only needed with ALLOW_HOST)
#   ALLOW_HOST="172.30.14.10:5678"   exceptions to reach the server: <container ip or any>:<tcp port>,
#                                space separated (for example: the bridge may call n8n's webhook)
#
# Safe to run again: it rebuilds its own rules and never duplicates them.
# Run by jc-isolate@<name>.service after Docker starts (Docker may rebuild its chains on restart).
set -eu

NAME=${1:-}
DIR=${JC_ISOLATE_DIR:-/etc/junkyard/isolate}
IPT=${IPTABLES:-iptables}

fail() { echo "jc-isolate: $*" >&2; exit 1; }

echo "$NAME" | grep -Eq '^[a-z0-9][a-z0-9-]{0,19}$' || fail "name must be 1-20 of a-z 0-9 -"
[ -r "$DIR/$NAME.conf" ] || fail "missing $DIR/$NAME.conf"
BRIDGE= SUBNET= GATEWAY= ALLOW_HOST=
. "$DIR/$NAME.conf"

IPV4='([0-9]{1,3}\.){3}[0-9]{1,3}'
echo "$BRIDGE" | grep -Eq '^[A-Za-z0-9_-]{1,15}$' || fail "BRIDGE is not a valid interface name"
[ -z "$SUBNET" ] || echo "$SUBNET" | grep -Eq "^$IPV4/[0-9]{1,2}\$" || fail "SUBNET must look like 172.30.14.0/24"
[ -z "$GATEWAY" ] || echo "$GATEWAY" | grep -Eq "^$IPV4\$" || fail "GATEWAY must be an IPv4 address"
for rule in $ALLOW_HOST; do
  echo "$rule" | grep -Eq "^($IPV4|any):[0-9]{1,5}\$" || fail "ALLOW_HOST entry '$rule' must be <ip or any>:<port>"
  [ -n "$GATEWAY" ] || fail "ALLOW_HOST needs GATEWAY"
done
$IPT -n -L DOCKER-USER >/dev/null 2>&1 || fail "Docker's DOCKER-USER chain is missing: start Docker first"

CHAIN="JC-$(echo "$NAME" | tr 'a-z-' 'A-Z_')"

# --- traffic from the containers through the server (to the internet, the home network, other networks)
$IPT -N "$CHAIN" 2>/dev/null || $IPT -F "$CHAIN"
$IPT -A "$CHAIN" -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN
[ -z "$SUBNET" ] || $IPT -A "$CHAIN" -d "$SUBNET" -j RETURN
for rule in $ALLOW_HOST; do
  src=${rule%:*} port=${rule##*:}
  # a port published on the server is DNAT-ed by Docker to a container: match the original target
  if [ "$src" = any ]; then
    $IPT -A "$CHAIN" -p tcp -m conntrack --ctorigdst "$GATEWAY" --ctorigdstport "$port" -j RETURN
  else
    $IPT -A "$CHAIN" -s "$src" -p tcp -m conntrack --ctorigdst "$GATEWAY" --ctorigdstport "$port" -j RETURN
  fi
done
for net in 0.0.0.0/8 10.0.0.0/8 100.64.0.0/10 127.0.0.0/8 169.254.0.0/16 172.16.0.0/12 192.0.0.0/24 \
           192.168.0.0/16 198.18.0.0/15 224.0.0.0/3; do
  $IPT -A "$CHAIN" -d "$net" -j DROP
done
$IPT -A "$CHAIN" -j RETURN
$IPT -C DOCKER-USER -i "$BRIDGE" -j "$CHAIN" 2>/dev/null || $IPT -I DOCKER-USER -i "$BRIDGE" -j "$CHAIN"

# --- traffic from the containers to the server itself: nothing new, except the exceptions
$IPT -C INPUT -i "$BRIDGE" -m conntrack --ctstate NEW -j DROP 2>/dev/null || \
  $IPT -I INPUT -i "$BRIDGE" -m conntrack --ctstate NEW -j DROP
for rule in $ALLOW_HOST; do
  src=${rule%:*} port=${rule##*:}
  if [ "$src" = any ]; then set -- ; else set -- -s "$src"; fi
  # inserted above the DROP (when docker-proxy answers instead of DNAT)
  $IPT -C INPUT -i "$BRIDGE" "$@" -p tcp --dport "$port" -m conntrack --ctstate NEW -j ACCEPT 2>/dev/null || \
    $IPT -I INPUT -i "$BRIDGE" "$@" -p tcp --dport "$port" -m conntrack --ctstate NEW -j ACCEPT
done
echo "jc-isolate: $NAME ($BRIDGE) is limited to the internet${ALLOW_HOST:+ and $ALLOW_HOST}"
