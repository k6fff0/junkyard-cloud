DOMAIN=https://password.example.com
SIGNUPS_ALLOWED=false         # never true: the site is public. The owner's email is invited (services.md)
INVITATIONS_ALLOWED=true
SHOW_PASSWORD_HINT=false
PASSWORD_HINTS_ALLOWED=false
IP_HEADER=CF-Connecting-IP
LOGIN_RATELIMIT_SECONDS=60
LOGIN_RATELIMIT_MAX_BURST=5
ADMIN_RATELIMIT_SECONDS=300
ADMIN_RATELIMIT_MAX_BURST=3
ADMIN_TOKEN=                  # empty = the admin page is off; set only for the invitation, then emptied
TZ=Europe/Lisbon
