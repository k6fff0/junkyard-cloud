NEXTAUTH_URL=https://links.example.com
NEXTAUTH_SECRET=generate
MEILI_MASTER_KEY=generate
OPENAI_API_KEY=from secrets.json
INFERENCE_TEXT_MODEL=gpt-6-luna
INFERENCE_IMAGE_MODEL=gpt-6-luna
INFERENCE_LANG=english
INFERENCE_USE_MAX_COMPLETION_TOKENS=true
INFERENCE_CONTEXT_LENGTH=4096
INFERENCE_ENABLE_AUTO_SUMMARIZATION=true
EMBEDDING_TEXT_MODEL=text-embedding-3-small
OCR_LANGS=eng
DB_WAL_MODE=true
DISABLE_SIGNUPS=false          # tools/karakeep-setup.py makes the owner's account, then true and up -d
RATE_LIMITING_ENABLED=true
# Reading a page takes a whole browser. Under 16 GB of RAM keep the archive copy and the screenshot off: on a
# small test machine they timed out on every link (the link was saved, but with no title or summary).
CRAWLER_FULL_PAGE_ARCHIVE=false
CRAWLER_STORE_SCREENSHOT=false
CRAWLER_NUM_WORKERS=1
CRAWLER_NAVIGATE_TIMEOUT_SEC=60
CRAWLER_JOB_TIMEOUT_SEC=180
CRAWLER_VIDEO_DOWNLOAD=false
CRAWLER_VIDEO_DOWNLOAD_ON_DEMAND=true
CRAWLER_VIDEO_DOWNLOAD_MAX_SIZE=300
MAX_ASSET_SIZE_MB=100
CRAWLER_BROWSER_TIMEZONE=Europe/Lisbon
TZ=Europe/Lisbon
DISABLE_NEW_RELEASE_CHECK=true
