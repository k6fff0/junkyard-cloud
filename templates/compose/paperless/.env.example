DOMAIN=example.com
TZ=Europe/Lisbon
PAPERLESS_DIR=/mnt/storage/paperless
POSTGRES_PASSWORD=generate
SECRET_KEY=generate
ADMIN_USER=admin
ADMIN_PASSWORD=generate (give it to the owner)
ADMIN_MAIL=owner@example.com
DATE_ORDER=DMY
# Tesseract languages to install, and the ones used for reading (e.g. ara / ara+eng, deu / deu+eng)
OCR_INSTALL=eng
OCR_LANGUAGE=eng
